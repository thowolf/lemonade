  "error_scenarios": {
    "vram_exhaustion": {
      "trigger_threshold_gb": 100,
      "expected_error_types": ["vram_exhaustion", "out_of_memory", "gpu_memory_error"],
      "acceptable_messages": [
        "insufficient VRAM",
        "out of memory",
        "GPU memory",
        "VRAM exhausted",
        "cannot allocate"
      ]
    },
    "model_conflicts": {
      "description": "Test loading incompatible model combinations",
      "expected_error_types": ["model_incompatible", "backend_conflict"]
    }
  },
  "concurrent_test_configs": {
    "thread_pool_size": 4,
    "request_timeout_seconds": 30,
    "max_retries": 3,
    "inter_request_delay_ms": 100
