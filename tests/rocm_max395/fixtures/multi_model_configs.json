  "performance_targets": {
    "max_concurrent_models": 3,
    "max_total_vram_gb": 100,
    "min_routing_accuracy": 0.8,
    "max_load_time_seconds": 300,
    "min_generation_quality": 0.5,
    "min_instruction_following": 0.6
