      "description": "Test model routing and response differentiation"
    },
    {
      "name": "vram_boundary",
      "models": ["llama-3.2-7b-instruct-gguf", "llama-3.2-13b-instruct-gguf"],
      "expected_total_vram_gb": 30.0,
      "description": "Test VRAM usage near capacity limits"
    }
  ],
  "model_types": {
    "generation": [
      "llama-3.2-1b-instruct-gguf",
      "llama-3.2-7b-instruct-gguf",
      "llama-3.2-13b-instruct-gguf"
    ],
    "instruction_tuned": [
      "llama-3.2-1b-instruct-gguf",
