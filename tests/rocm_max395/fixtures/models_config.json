  "test_scenarios": {
    "basic_inference": {
      "models": ["llama-3.2-1b-instruct-gguf"],
      "backends": ["rocm"],
      "prompts": 5,
      "iterations": 3,
      "description": "Basic inference validation"
    },
    "performance_benchmark": {
      "models": ["llama-3.2-1b-instruct-gguf", "llama-3.2-7b-instruct-gguf", "llama-3.2-13b-instruct-gguf"],
      "backends": ["rocm", "vulkan", "cpu"],
      "prompts": 10,
      "iterations": 5,
      "description": "Performance comparison across models and backends"
    },
    "vram_stress_test": {
      "models": ["llama-3.2-30b-instruct-gguf"],
      "backends": ["rocm"],
      "prompts": 3,
      "iterations": 1,
      "description": "VRAM utilization and stability testing"
    },
    "rag_integration": {
      "models": ["llama-3.2-7b-instruct-gguf"],
      "backends": ["rocm"],
      "prompts": 5,
      "iterations": 3,
      "context_lengths": [1024, 4096, 8192],
      "description": "RAG pipeline testing with varying context lengths"
    },
    "multi_model_concurrency": {
      "models": ["llama-3.2-1b-instruct-gguf", "llama-3.2-7b-instruct-gguf"],
      "backends": ["rocm"],
      "concurrent_requests": 4,
      "iterations": 3,
      "description": "Multi-model concurrent inference testing"
    }
  },
