      "flags": ["--llamacpp", "rocm"]
    },
    "vulkan": {
      "name": "Vulkan",
      "description": "Cross-platform GPU acceleration via Vulkan",
      "supported_architectures": ["any"],
      "requirements": ["Vulkan-compatible GPU"],
      "flags": ["--llamacpp", "vulkan"]
    },
    "cpu": {
      "name": "CPU",
      "description": "CPU-only inference (baseline)",
